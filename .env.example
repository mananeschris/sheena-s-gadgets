PORT=3000
AI_ASSISTANT_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
NODE_ENV=development
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=fintech_db
DB_PORT=3307
DB_SSL=false
# For hosted MySQL: set DB_SSL=true; custom CA certificates can be base64 encoded here.
DB_SSL_CA_BASE64=
# Local development uses disk. Render Free uses supabase and a PRIVATE bucket.
STORAGE_PROVIDER=disk
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=shop-files
# Required only for production disk storage on a paid persistent mount.
STORAGE_DIR=

# Public origin used for password recovery links; use your HTTPS URL in production.
APP_BASE_URL=http://localhost:3000
GCASH_ACCOUNT_NAME=SH*** M** C.
GCASH_ACCOUNT_NUMBER=09XXXXXXXXX
GCASH_QR_IMAGE=/assets/gcash-store-qr-code.png

# Optional absolute private directory; defaults to data/delivery-proofs.
# Use persistent storage for deployed delivery photos.
DELIVERY_PROOF_DIR=

# Email verification provider (required for admin sign-in, including local development)
# Recommended: Brevo Transactional Email API
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_NAME=Sheena's Gadgets & Accessories Shop
EMAIL_FROM_ADDRESS=your_verified_sender_email@example.com

# Optional alternative: Resend
# RESEND_API_KEY=your_resend_api_key_here
# EMAIL_FROM="Sheena's Gadgets & Accessories Shop <onboarding@resend.dev>"
EMAIL_VERIFICATION_SECRET=change_this_to_a_long_random_secret
